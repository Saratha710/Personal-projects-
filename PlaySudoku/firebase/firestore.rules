rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{board}/entries/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'country', 'score', 'seconds', 'mistakes'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 16
        && request.resource.data.country is string
        && request.resource.data.country.size() == 2
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= (board.matches('alltime_.*') ? 100000000 : 8000);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
